{
  "schema": 1,
  "project": {
    "schema": 1,
    "projectId": "just-every/run-nectar",
    "name": "Nectar",
    "sourceRepository": "https://github.com/just-every/run-nectar",
    "license": "MIT",
    "deployment": {
      "target": "cloudflare-workers",
      "artifactFile": "rer-worker-artifact.json"
    },
    "operations": {
      "setup": "pnpm install --frozen-lockfile && pnpm exec rer install",
      "build": "pnpm run build",
      "verify": "pnpm run verify && pnpm check:deployment-spec && pnpm exec rer check --profile first-party",
      "artifact": "node scripts/delivery/base/cli.mjs artifact --config packaging.json",
      "recovery": "Follow OPERATIONS.md: retain source and private settings, export domain data, restore into fresh empty resources, run owner setup, re-export and compare before switching traffic. Preserve applied migration names and bytes."
    },
    "verification": {
      "migrationDirectories": [
        "migrations/core"
      ]
    }
  },
  "managed": {
    "workflowRef": "runeditrun/delivery/.github/workflows/trusted-build.yml@86c8b37399c901bffd9a240dbd1148a65ec83b34",
    "artifactFile": "rer-worker-artifact.json",
    "buildProfile": "project",
    "verificationProfiles": [
      "full"
    ]
  },
  "artifact": {
    "specInputs": {
      "publicVariableNames": [
        "AUTH_LOCAL",
        "AUTH_ORIGIN",
        "MAIL_PROVIDER",
        "MAIL_FROM",
        "MAIL_RELAY_URL",
        "MAIL_ACCOUNT_ID"
      ],
      "secretNames": [
        "OWNER_EMAIL",
        "SESSION_SECRET",
        "SETUP_TOKEN",
        "MFA_KEY",
        "PORTAL_KEY",
        "MAIL_API_KEY"
      ],
      "optionalSecretNames": [
        "STRIPE_BILLING_SECRET",
        "QUICKBOOKS_ACCESS_TOKEN",
        "QUICKBOOKS_ENVIRONMENT",
        "QUICKBOOKS_COMPANY_ID"
      ],
      "migrationPrefix": "core-",
      "recovery": "Export domain data and retain private configuration. Restore into fresh empty resources, establish the owner and compare a fresh export before routing traffic. Preserve applied migration history.",
      "providerEffects": [
        "outbound-mail",
        "outbound-webhooks"
      ],
      "mail": {
        "providers": [
          "rer",
          "resend",
          "sendgrid",
          "cloudflare"
        ]
      },
      "surfaces": {
        "app": {
          "path": "/app",
          "originVariable": "AUTH_ORIGIN",
          "signIn": {
            "path": "/signin",
            "loginHint": false,
            "ownerSignIn": "/auth/owner-signin"
          }
        }
      }
    }
  },
  "setup": {
    "manifestFile": "rer-setup.json"
  },
  "edition": {
    "manifestFile": "edition.json",
    "componentId": "just-every/run-nectar"
  }
}
