{
  "name": "@billing/nectar",
  "version": "0.1.1",
  "private": true,
  "type": "module",
  "engines": {
    "node": "22.20.0"
  },
  "scripts": {
    "build": "rer build",
    "dev": "rer dev",
    "preview": "rer preview",
    "typecheck": "tsc --build --incremental",
    "verify": "rer verify",
    "setup": "rer setup",
    "deploy": "rer deploy",
    "test:runtime": "rer queue test:runtime -- sh -c \"node tests/runtime.mjs\"",
    "onboard": "node scripts/install.mjs",
    "build:app": "rer queue build:app -- sh -c \"vite build\"",
    "verify:app": "node scripts/verify-app.mjs",
    "reset": "rer reset",
    "export": "rer export",
    "import": "rer import",
    "release": "rer release",
    "doctor": "rer doctor",
    "describe": "rer describe",
    "check": "rer check",
    "deps": "rer install",
    "rer": "rer",
    "test:flows": "rer queue test:flows -- sh -c \"node tests/nectar/flows.mjs\"",
    "test:journey": "node tests/nectar/journey.mjs",
    "test:passkey": "node tests/nectar/mfa-passkey.mjs",
    "delivery:spec": "node scripts/build-deployment-spec.mjs",
    "check:deployment-spec": "node scripts/build-deployment-spec.mjs --check",
    "test:recovery": "node scripts/verify-checkout.mjs",
    "test:audit-consolidated": "node tests/nectar/sanity.mjs && node tests/nectar/processor-journey.mjs"
  },
  "dependencies": {
    "@node-saml/node-saml": "5.1.0",
    "@tanstack/react-router": "1.170.41",
    "@tanstack/react-start": "1.168.60",
    "hono": "4.13.7",
    "react": "19.2.8",
    "react-dom": "19.2.8"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "1.54.5",
    "@cloudflare/workers-types": "5.20260908.1",
    "@playwright/test": "1.63.0",
    "@runeditrun/rer": "0.2.86",
    "@types/node": "22.20.5",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.7",
    "@vitejs/plugin-react": "6.1.1",
    "marked": "18.0.14",
    "typescript": "5.9.3",
    "vite": "8.2.2",
    "wrangler": "4.129.1"
  },
  "packageManager": "pnpm@10.12.4",
  "pnpm": {
    "overrides": {
      "sharp": "0.35.5",
      "undici": "7.29.1"
    },
    "onlyBuiltDependencies": [
      "esbuild",
      "workerd"
    ]
  },
  "repository": "https://github.com/just-every/run-nectar",
  "license": "MIT"
}
