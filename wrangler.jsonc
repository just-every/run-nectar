{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "billing-nectar",
  "main": "src/server.ts",
  "compatibility_date": "2026-09-08",
  "compatibility_flags": [
    "nodejs_compat"
  ],
  "triggers": { "crons": ["0 14 * * *"] },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "nectar",
      "database_id": "local-nectar-only",
      "migrations_dir": "migrations/core"
    }
  ]
}
