{
  "compilerOptions": {
    "target": "ES2022",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "lib": ["ES2023", "DOM", "DOM.Iterable"],
    "types": ["node"],
    "strict": true,
    "declaration": true,
    "sourceMap": true,
    "rootDir": "../..",
    "outDir": "dist",
    "skipLibCheck": true
  },
  "include": ["src/**/*.ts", "../../sdks/typescript/src/**/*.ts"]
}
